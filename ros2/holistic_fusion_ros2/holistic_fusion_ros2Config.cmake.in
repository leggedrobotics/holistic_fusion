@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/holistic_fusion_ros2Targets.cmake")

# Set include directories for downstream packages
set_and_check(holistic_fusion_ros2_INCLUDE_DIR "${PACKAGE_PREFIX_DIR}/include")
set(holistic_fusion_ros2_INCLUDE_DIRS "${holistic_fusion_ros2_INCLUDE_DIR}")

# Legacy-style variables for compatibility
set(holistic_fusion_ros2_LIBRARIES holistic_fusion_ros2::holistic_fusion_ros2)

check_required_components(holistic_fusion_ros2)
